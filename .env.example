# Base URL of the external HDI conflict engine (Python/FastAPI, see hdi-api/).
# Defaults to http://127.0.0.1:8000 if unset. Copy this file to .env.local.
ENGINE_URL=http://127.0.0.1:8000

# Base URL of the Python intake service (OCR + standardize, see standardizer/server.py).
# Defaults to http://127.0.0.1:8001 if unset.
INTAKE_URL=http://127.0.0.1:8001
